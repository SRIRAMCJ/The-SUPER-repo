{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://super-repo.dev/schemas/skill.schema.json",
  "title": "SUPER Skill",
  "description": "Reusable domain capability contract consumed by agents and workflows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "name", "version", "status", "description", "provenance", "purpose", "inputs", "outputs"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "kind": { "const": "skill" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["experimental", "alpha", "beta", "stable", "deprecated", "disabled"] },
    "description": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "capability.schema.json#/properties/provenance" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "inputs": { "type": "array", "items": { "$ref": "#/definitions/port" } },
    "outputs": { "type": "array", "items": { "$ref": "#/definitions/port" } },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "sideEffects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "verification": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "definitions": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$" },
        "type": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "schema": { "type": ["object", "string"] }
      }
    }
  }
}

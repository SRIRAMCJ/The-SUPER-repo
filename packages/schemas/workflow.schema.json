{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://super-repo.dev/schemas/workflow.schema.json",
  "title":"SUPER Workflow",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","id","kind","name","version","status","description","provenance","steps"],
  "properties":{
    "schemaVersion":{"type":"string","const":"0.1.0"},"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._/-]*$"},"kind":{"const":"workflow"},"name":{"type":"string","minLength":1,"maxLength":120},
    "version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "status":{"type":"string","enum":["experimental","alpha","beta","stable","deprecated","disabled"]},"description":{"type":"string","minLength":1,"maxLength":2000},"provenance":{"$ref":"common.schema.json#/$defs/provenance"},
    "inputs":{"type":"array","items":{"$ref":"common.schema.json#/$defs/port"}},"outputs":{"type":"array","items":{"$ref":"common.schema.json#/$defs/port"}},
    "steps":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","capability"],"properties":{"id":{"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9._-]*$"},"capability":{"$ref":"common.schema.json#/$defs/reference"},"dependsOn":{"type":"array","items":{"type":"string"},"uniqueItems":true},"input":{"type":"object","additionalProperties":true},"condition":{"type":"string","maxLength":2000},"continueOnError":{"type":"boolean","default":false}}}},
    "metadata":{"type":"object","additionalProperties":true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://super-repo.dev/schemas/model.schema.json",
  "title": "SUPER Model Capability",
  "description": "Contract for model providers and routable model capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "name", "version", "status", "description", "provenance", "provider", "capabilities"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "kind": { "const": "model" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "status": { "type": "string", "enum": ["experimental", "alpha", "beta", "stable", "deprecated", "disabled"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "provenance": { "$ref": "capability.schema.json#/$defs/provenance" },
    "provider": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "contextWindow": { "type": "integer", "minimum": 1 },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputPerMillionTokens": { "type": "number", "minimum": 0 },
        "outputPerMillionTokens": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 1 }
      }
    },
    "limits": { "type": "object", "additionalProperties": true },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}

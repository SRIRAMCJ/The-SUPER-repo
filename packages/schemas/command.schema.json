{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://super-repo.dev/schemas/command.schema.json",
  "title": "SUPER Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","id","kind","name","version","status","description","provenance","action"],
  "properties": {
    "schemaVersion":{"type":"string","const":"0.1.0"},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._/-]*$"},
    "kind":{"const":"command"},
    "name":{"type":"string","minLength":1,"maxLength":120},
    "version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "status":{"type":"string","enum":["experimental","alpha","beta","stable","deprecated","disabled"]},
    "description":{"type":"string","minLength":1,"maxLength":2000},
    "provenance":{"$ref":"common.schema.json#/$defs/provenance"},
    "action":{"type":"string","minLength":1,"maxLength":2000},
    "arguments":{"type":"array","items":{"$ref":"common.schema.json#/$defs/port"}},
    "permissions":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "metadata":{"type":"object","additionalProperties":true}
  }
}

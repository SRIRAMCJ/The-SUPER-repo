{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://super-repo.dev/schemas/capability.schema.json",
  "title": "SUPER Capability",
  "description": "Common contract metadata shared by executable SUPER capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "name", "version", "status", "description", "provenance"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "kind": { "type": "string", "enum": ["agent", "skill", "tool", "command", "workflow", "team", "mission", "model", "memory", "artifact", "plugin", "policy", "evaluation", "benchmark", "event", "execution"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "status": { "type": "string", "enum": ["experimental", "alpha", "beta", "stable", "deprecated", "disabled"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "uniqueItems": true },
    "authors": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "license": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType"],
      "properties": {
        "sourceType": { "type": "string", "enum": ["native", "adapted", "generated", "vendored", "external"] },
        "source": { "type": "string", "maxLength": 1000 },
        "sourceVersion": { "type": "string", "maxLength": 200 },
        "attribution": { "type": "string", "maxLength": 2000 }
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
